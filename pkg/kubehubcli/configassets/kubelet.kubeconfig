apiVersion: v1
kind: Config
clusters:
- name: {{.ClusterName}}
  cluster:
    certificate-authority: {{.CAFile}}
    server: {{.Server}}
users:
- name: kubelet
  user:
    client-certificate: {{.CertFile}}
    client-key: {{.KeyFile}}
contexts:
- name: kubelet-context
  context:
    cluster: {{.ClusterName}}
    user: kubelet
current-context: kubelet-context