apiVersion: v1
kind: Config
clusters:
- name: {{.ClusterName}}
  cluster:
    certificate-authority: {{.CAFile}}
    server: {{.Server}}
users:
- name: kube-scheduler
  user:
    client-certificate: {{.CertFile}}
    client-key: {{.KeyFile}}
contexts:
- name: scheduler-context
  context:
    cluster: {{.ClusterName}}
    user: kube-scheduler
current-context: scheduler-context