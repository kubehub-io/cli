apiVersion: v1
kind: Config
clusters:
- name: {{.ClusterName}}
  cluster:
    certificate-authority: {{.CAFile}}
    server: {{.Server}}
users:
- name: kube-controller-manager
  user:
    client-certificate: {{.CertFile}}
    client-key: {{.KeyFile}}
contexts:
- name: controller-manager-context
  context:
    cluster: {{.ClusterName}}
    user: kube-controller-manager
current-context: controller-manager-context